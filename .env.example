# Copie este arquivo para .env.local e preencha com suas chaves.

# Site
NEXT_PUBLIC_SITE_URL=https://quintal.vercel.app

# Supabase — armazenamento dos leads da waitlist
# Projeto já criado: "familyos" (id izattwaiqjzhydzhxlns, org
# miguelsnahas-ai's Org) — o mesmo projeto do backend do produto, mas a
# landing só grava na tabela waitlist_leads. Ela tem RLS habilitado com
# policy de INSERT apenas — por isso é seguro usar a chave anon/
# publishable aqui, sem precisar da service_role key nem dar acesso às
# outras tabelas do produto.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Resend — email de confirmação da waitlist
# Crie uma conta em resend.com, verifique um domínio (ou use o domínio
# de teste deles) e gere uma API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Quintal <ola@quintal.com.br>"

# Analytics (todos opcionais — a seção correspondente só é ativada se a
# variável estiver definida)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_META_PIXEL_ID=

# Link do Calendly mostrado na página /obrigado (opcional)
NEXT_PUBLIC_CALENDLY_URL=
